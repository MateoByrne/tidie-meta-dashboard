# Supabase → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_... or legacy "anon"). Read-only thanks to RLS.
# Used by the dashboard on the server. Set this one in Vercel too.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_... or legacy "service_role"). Bypasses RLS.
# ONLY for the local import script. Never set it in Vercel, never commit it.
SUPABASE_SECRET_KEY=
